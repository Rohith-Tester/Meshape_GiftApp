# Copy this file to .env for local development. Never commit the real .env
# file. In production (Vercel), set these in the project's Environment
# Variables settings instead — never commit real values anywhere.

# --- Base path ---
# Only needed if the site is served from a sub-path instead of the domain root.
VITE_BASE_PATH=/

# --- Firebase (Phase 8) ---
# From: Firebase Console → Project Settings → General → "Your apps" → Web app.
# None of these are secrets, despite "apiKey" sounding like one — they are
# public identifiers for your Firebase project. The actual security
# boundary is firestore.rules + Firebase Auth, not hiding these values.
# See src/lib/firebase.js and PROJECT_REQUIREMENTS.md → "Phase 8
# architecture notes" for the full explanation.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Cloudinary (Phase 8) ---
# From: Cloudinary Dashboard → cloud name is shown on the dashboard home;
# create the upload preset under Settings → Upload → Upload presets →
# "Add upload preset", set Signing Mode to "Unsigned", and restrict it
# (allowed formats jpg/png/webp, max file size, a fixed folder) — see
# admin-scripts/README.md and src/utils/cloudinaryUpload.js for why this
# is an unsigned-with-restrictions setup, not a fully signed one, and
# what that tradeoff means.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# --- Never put here, ever ---
# CLOUDINARY_API_SECRET, any Firebase service account key, or any other
# server-side secret must NEVER be prefixed VITE_ or placed in this file
# — that prefix is what tells Vite to bundle a value into the public,
# downloadable JS the browser receives. The only place a Firebase service
# account key belongs is admin-scripts/service-account-key.json, which is
# gitignored and never deployed. This project currently has no
# server-side secrets at all, because Cloud Functions (the only place one
# would be used) were deliberately not built — see
# PROJECT_REQUIREMENTS.md for why.
