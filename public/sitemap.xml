<?xml version="1.0" encoding="UTF-8"?>
<!--
  This lists the static top-level routes only. Product detail URLs
  (/product/:id) come from Firestore at runtime and can change any time
  an admin adds/removes a product — there's no build-time list of them
  to generate against in this client-rendered SPA. Search engines that
  execute JavaScript (Google, Bing) will still discover and index
  individual product pages by following links from /products and the
  homepage; this file just gives crawlers a direct, low-effort entry
  point to the site's fixed structure. Update the domain below once the
  production URL is known.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://REPLACE-WITH-YOUR-DOMAIN/</loc>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>https://REPLACE-WITH-YOUR-DOMAIN/products</loc>
    <changefreq>daily</changefreq>
    <priority>0.9</priority>
  </url>
  <url>
    <loc>https://REPLACE-WITH-YOUR-DOMAIN/shop</loc>
    <changefreq>monthly</changefreq>
    <priority>0.6</priority>
  </url>
  <url>
    <loc>https://REPLACE-WITH-YOUR-DOMAIN/about</loc>
    <changefreq>monthly</changefreq>
    <priority>0.4</priority>
  </url>
  <url>
    <loc>https://REPLACE-WITH-YOUR-DOMAIN/contact</loc>
    <changefreq>monthly</changefreq>
    <priority>0.4</priority>
  </url>
</urlset>
